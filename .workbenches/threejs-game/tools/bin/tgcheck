#!/usr/bin/env bash
# tgcheck [game-dir] [--next] [--playtest <script.mjs> [--only a,b]] [--manifest artifacts/evidence.json] [--port 5188]
# The bench gate. Installs dependencies if needed, runs the production build
# (build:test if the project defines it; typecheck included), serves the build
# output (Vite build.outDir, default dist/) in the background, captures every
# viewport/state pair the manifest declares with the canvas inspector, runs
# the evidence checker against that same run, then runs the playtest script
# when one is given (with TG_URL set to the served build). Stops the server,
# writes artifacts/tgcheck.json. Exit 0 means every hard check passed.
#   --next      bump the manifest's runId (pass-N -> pass-N+1) and its report
#               paths before capturing; use it for every re-gate after a change
#   --only      run only these playtest sections (passed as TG_ONLY); a partial
#               gate, so the final gate runs without it
# Each step's time is printed and recorded. Past 4 minutes it warns: the model's
# prompt cache expires at 5, so split the work rather than run long.
set -uo pipefail

SKILLS=/opt/threejs-game/skills
dir=.
manifest=artifacts/evidence.json
port=5188
next=0
playtest=
only=
while [[ $# -gt 0 ]]; do
    case $1 in
        --manifest) manifest=$2; shift 2 ;;
        --port) port=$2; shift 2 ;;
        --next) next=1; shift ;;
        --playtest) playtest=$2; shift 2 ;;
        --only) only=$2; shift 2 ;;
        -h|--help) sed -n 2,15p "$0"; exit 0 ;;
        *) dir=$1; shift ;;
    esac
done
cd "$dir" || { echo "tgcheck: no such directory: $dir" >&2; exit 2; }
mkdir -p artifacts

steps=()
fail=0
t0=$SECONDS
mark=$SECONDS
record() {
    local took=$((SECONDS - mark))
    steps+=("{\"step\":\"$1\",\"ok\":$2,\"seconds\":$took}")
    echo "   $1: $([[ $2 == true ]] && echo ok || echo FAILED) (${took}s)"
    mark=$SECONDS
    [[ $2 == true ]] || fail=1
}
finish() {
    local IFS=,
    local total=$((SECONDS - t0))
    printf '{"ok":%s,"partial":%s,"seconds":%s,"url":"http://127.0.0.1:%s","manifest":"%s","steps":[%s]}\n' \
        "$([[ $fail == 0 ]] && echo true || echo false)" "$([[ -n $only ]] && echo true || echo false)" \
        "$total" "$port" "$manifest" "${steps[*]}" > artifacts/tgcheck.json
    tgserve stop --port "$port" > /dev/null 2>&1
    echo "tgcheck: ${total}s total"
    if (( total > 240 )); then
        echo "tgcheck: WARNING took $((total / 60))m$((total % 60))s. Past 5 minutes the prompt cache expires; iterate without --playtest or with --only <sections>."
    fi
    if [[ $fail == 0 && -n $only ]]; then echo "tgcheck: PASS (partial: --only $only)"
    elif [[ $fail == 0 ]]; then echo "tgcheck: PASS"; else echo "tgcheck: FAIL (see above)"; fi
    exit $fail
}

[[ -f package.json ]] || { echo "tgcheck: no package.json in $(pwd). Scaffold with tgnew first." >&2; exit 2; }

if [[ $next == 1 && -f $manifest ]]; then
    node -e '
      const fs = require("fs"), p = process.argv[1];
      const m = JSON.parse(fs.readFileSync(p, "utf8"));
      const old = String(m.runId), n = old.match(/(\d+)$/);
      const run = n ? old.slice(0, -n[1].length) + (Number(n[1]) + 1) : old + "-2";
      m.runId = run;
      for (const c of m.captures ?? []) if (typeof c.report === "string") c.report = c.report.split(old).join(run);
      fs.writeFileSync(p, JSON.stringify(m, null, 2) + "\n");
      console.log("runId " + old + " -> " + run);
    ' "$manifest" || exit 2
fi

# Manifest shape: nonempty, at least one named state (a null state proves no
# gameplay). The evidence checker enforces the rest.
if ! node -e '
  const m = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
  const c = Array.isArray(m.captures) ? m.captures : [];
  if (!m.runId) throw new Error("manifest has no runId");
  if (!c.length) throw new Error("manifest declares no captures");
  if (!c.some(x => typeof x.state === "string" && x.state.length)) throw new Error("manifest needs at least one named state capture, not only null");
' "$manifest"; then
    echo "tgcheck: invalid or missing manifest $manifest (see threejs-game-director/references/evidence-manifest.md)" >&2
    record manifest false; finish
fi
record manifest true

echo "== install"
if [[ ! -d node_modules ]]; then
    # npm ci first for reproducibility. A lockfile out of sync with this
    # platform's optional dependencies (the vendored scaffold's is, on
    # linux-arm64) falls back to npm install, which repairs the lockfile.
    # A bun.lock selects bun: frozen install first, plain install as fallback.
    ok=false
    if [[ -f bun.lock ]]; then
        if bun install --frozen-lockfile || bun install; then ok=true; fi
    elif [[ -f package-lock.json ]] && npm ci --no-audit --no-fund; then ok=true
    elif npm install --no-audit --no-fund; then ok=true; fi
    record install $ok
    [[ $fail == 0 ]] || finish
fi

# Run scripts with the project's package manager.
if [[ -f bun.lock ]]; then run=(bun run); else run=(npm run); fi
# A build:test script builds with test hooks enabled; production builds may
# gate them behind an env flag. Otherwise the plain build is the gate build.
script=build
node -e 'process.exit(require("./package.json").scripts?.["build:test"] ? 0 : 1)' && script=build:test

echo "== build ($script)"
"${run[@]}" "$script"
record build $([[ $? == 0 ]] && echo true || echo false)
[[ $fail == 0 ]] || finish

echo "== preview on :$port"
if ! tgserve start --port "$port"; then
    record preview false; finish
fi
record preview true

echo "== inspect"
node "$SKILLS/threejs-qa-release/scripts/inspect-threejs-canvas.mjs" \
    --manifest "$manifest" --url "http://127.0.0.1:$port" --seed 42
record inspect $([[ $? == 0 ]] && echo true || echo false)

echo "== evidence"
python3 "$SKILLS/threejs-game-director/scripts/check_evidence.py" . --manifest "$manifest"
record evidence $([[ $? == 0 ]] && echo true || echo false)

if [[ -n $playtest ]]; then
    echo "== playtest $playtest"
    TG_URL="http://127.0.0.1:$port" TG_ONLY="$only" timeout 240 node "$playtest"
    record playtest $([[ $? == 0 ]] && echo true || echo false)
fi

finish
